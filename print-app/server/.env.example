# דוגמה לקובץ .env של מחשב ההדפסה (C:\BarTenderWebhook\.env).
# אין לשמור את הקובץ האמיתי במאגר.

# הסוד המשותף עם JP Quality לחתימת HMAC על /webhook. לא משנים אותו.
PRINT_WEBHOOK_SECRET=put-the-existing-secret-here

# מפתח גישה נפרד לכל עובד/טלפון/מחשב, בפורמט name:key, מופרדים בפסיקים.
# ליצירת מפתח: py -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEYS=yossi_phone:replace-with-generated-key,office_pc:replace-with-generated-key

# מי רואה באפליקציה את ההדפסות של כל המשתמשים (היסטוריה -> "כל ההדפסות").
# שמות מתוך API_KEYS, מופרדים בפסיקים. כל השאר רואים רק את ההדפסות שלהם.
HISTORY_ADMINS=office1,office2,yehuda
